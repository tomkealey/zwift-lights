[Unit]
Description=zwiftlights - Hue lights follow trainer power zones
After=network-online.target bluetooth.target bt-recover.service
Wants=network-online.target bluetooth.target

[Service]
User=__USER__
WorkingDirectory=__DIR__
ExecStartPre=-/usr/bin/bluetoothctl power on
ExecStart=__DIR__/venv/bin/python -u zwiftlights.py run
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
